---
// Visible breadcrumbs. The page's BreadcrumbList (src/lib/graph.ts) uses the same trail.
interface Props {
  trail: { name: string; path: string }[];
}
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {trail.map((t, i) => (
      <li>{i < trail.length - 1 ? <a href={t.path}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { font-size: 14px; color: var(--muted); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 4px 0; margin: 0; padding: 0; list-style: none; }
  .crumbs li:not(:last-child)::after { content: "›"; margin: 0 8px; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .crumbs span { overflow-wrap: anywhere; }
</style>
