---
import Base from "../layouts/Base.astro";
import { page } from "../data/pages";
import { graph, webPage } from "../lib/graph";
const p = page("/404");
const g = graph(webPage({ path: p.path, name: p.title, description: p.description }));
---
<Base seo={{ title: p.title, description: p.description, path: p.path, graph: g, noindex: p.noindex }}>
  <h1>{p.h1}</h1>
  <p>This page does not exist. Go back to the <a href="/">slash.markets home page</a> and try again.</p>
</Base>
