---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { page } from "../data/pages";
import { graph, webPage } from "../lib/graph";
const p = page("/terms");
const entry = await getEntry("legal", "terms");
if (!entry) throw new Error("src/content/legal/terms.md is missing");
const { Content } = await render(entry);
const g = graph(webPage({ path: p.path, name: p.title, description: p.description }));
---
<Base seo={{ title: p.title, description: p.description, path: p.path, graph: g }}>
  <a class="back" href="/">← slash.markets</a>
  <h1>{p.h1}</h1>
  <p class="meta">Last updated {entry.data.lastUpdated.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</p>
  <Content />
</Base>
